{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "STOCKSIM_WARNINGS_AS_ERRORS": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug (core tests + template_debug GDExtension)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "GODOTCPP_TARGET": "template_debug"
            }
        },
        {
            "name": "release",
            "displayName": "Release (template_release GDExtension)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "GODOTCPP_TARGET": "template_release"
            }
        },
        {
            "name": "core-only",
            "displayName": "Core library + tests only (no godot-cpp)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "STOCKSIM_BUILD_GDEXT": "OFF"
            }
        }
    ],
    "buildPresets": [
        { "name": "debug", "configurePreset": "debug" },
        { "name": "release", "configurePreset": "release" },
        { "name": "core-only", "configurePreset": "core-only" }
    ],
    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "core-only",
            "configurePreset": "core-only",
            "output": { "outputOnFailure": true }
        }
    ]
}
