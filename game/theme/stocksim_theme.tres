[gd_resource type="Theme" load_steps=10 format=3]

[sub_resource type="SystemFont" id="SystemFont_ui"]
font_names = PackedStringArray("Segoe UI", "Inter", "Noto Sans", "Helvetica", "sans-serif")

[sub_resource type="SystemFont" id="SystemFont_mono"]
