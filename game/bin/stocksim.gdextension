[configuration]

entry_symbol = "stocksim_library_init"
compatibility_minimum = "4.7"

[libraries]

windows.debug.x86_64 = "res://bin/libstocksim.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libstocksim.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libstocksim.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libstocksim.linux.template_release.x86_64.so"
macos.debug = "res://bin/libstocksim.macos.template_debug.framework"
macos.release = "res://bin/libstocksim.macos.template_release.framework"
