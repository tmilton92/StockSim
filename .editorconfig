root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,hpp,h,in}]
indent_style = space
indent_size = 4
max_line_length = 100

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 4

[*.{gd,tscn,tres,godot,gdextension,cfg}]
indent_style = tab
indent_size = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{ps1,bat,cmd}]
end_of_line = crlf
indent_style = space
indent_size = 4
